rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function canReadWorkspace(workspaceId) {
      return signedIn();
    }

    function canWriteWorkspace(workspaceId) {
      return signedIn() && memberRole(workspaceId) in ["admin", "editor"];
    }

    function canManageMembers(workspaceId) {
      return signedIn() && memberRole(workspaceId) == "admin";
    }

    match /workspaces/{workspaceId}/state/main {
      allow read: if canReadWorkspace(workspaceId);
      allow write: if canWriteWorkspace(workspaceId);
    }

    match /workspaces/{workspaceId}/members/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManageMembers(workspaceId));
      allow create, update, delete: if canManageMembers(workspaceId);
    }

    match /workspaces/{workspaceId}/userDirectory/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canManageMembers(workspaceId));
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if canManageMembers(workspaceId);
    }

    match /users/{userId}/privateState/main {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
